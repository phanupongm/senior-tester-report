          "level": "warning",
          "message": {
            "text": "Excel export garbles non-ASCII filenames — Steps: Create an exam named \"Économie 101\" → Export scores to Excel → Downloaded file is named \"_conomie 101.xlsx\""
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
